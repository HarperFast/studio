{
	"name": "fabric_ui",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "dotenv -e .env.local -- npm run vite-host",
		"dev:local": "dotenv -e .env.localstudio.local -- npm run vite-host",
		"vite-host": "vite --host \"$VITE_HOST\"",
		"build": "tsc -b && vite build",
		"build:local": "tsc -b && vite build --mode localstudio",
		"build:dev": "tsc -b && vite build --mode dev",
		"build:stage": "tsc -b && vite build --mode stage",
		"build:prod": "tsc -b && vite build --mode prod",
		"commitlint": "commitlint --edit",
		"release": "semantic-release",
		"update-sdk": "dotenv -e .env.local -- npm run update-sdk:fetch && npx -y openapi-typescript --root-types --alphabetize --enum ./dist/central-manager.json -o src/integrations/api/api.gen.d.ts",
		"update-sdk:fetch": "mkdir -p dist && curl --location \"$VITE_CENTRAL_MANAGER_API_URL/openapi\" -u \"$HDB_ADMIN_USERNAME_FOR_OPENAPI:$HDB_ADMIN_PASSWORD_FOR_OPENAPI\" -o ./dist/central-manager.json",
		"lint": "eslint .",
		"prepare": "husky",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@datadog/browser-rum": "^6.18.0",
		"@datadog/browser-rum-react": "^6.18.0",
		"@hookform/resolvers": "^5.0.0",
		"@monaco-editor/react": "^4.7.0",
		"@radix-ui/react-alert-dialog": "^1.1.6",
		"@radix-ui/react-dialog": "^1.1.6",
		"@radix-ui/react-dropdown-menu": "^2.1.6",
		"@radix-ui/react-label": "^2.1.2",
		"@radix-ui/react-navigation-menu": "^1.2.5",
		"@radix-ui/react-radio-group": "^1.2.3",
		"@radix-ui/react-scroll-area": "^1.2.4",
		"@radix-ui/react-select": "^2.1.6",
		"@radix-ui/react-separator": "^1.1.2",
		"@radix-ui/react-slot": "^1.1.2",
		"@radix-ui/react-tabs": "^1.1.3",
		"@radix-ui/react-toggle": "^1.1.10",
		"@radix-ui/react-tooltip": "^1.1.8",
		"@stripe/react-stripe-js": "^4.0.0",
		"@stripe/stripe-js": "^7.8.0",
		"@tailwindcss/vite": "^4.0.9",
		"@tanstack/react-query": "^5.90.2",
		"@tanstack/react-query-devtools": "^5.90.2",
		"@tanstack/react-router": "^1.132.25",
		"@tanstack/react-router-devtools": "^1.132.25",
		"@tanstack/react-table": "^8.21.2",
		"@types/node": "^22.13.5",
		"axios": "^1.7.9",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.554.0",
		"next-themes": "^0.4.4",
		"react": "^19.0.0",
		"react-complex-tree": "^2.6.1",
		"react-dom": "^19.0.0",
		"react-hook-form": "^7.54.2",
		"react-markdown": "^10.1.0",
		"recharts": "^3.2.1",
		"reodotdev": "^1.0.0",
		"sonner": "^2.0.1",
		"swagger-ui-react": "^5.29.0",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.0.9",
		"tailwindcss-animate": "^1.0.7",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.0.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@eslint/js": "^9.19.0",
		"@semantic-release/commit-analyzer": "^13.0.0",
		"@semantic-release/github": "^12.0.0",
		"@semantic-release/release-notes-generator": "^14.0.0",
		"@testing-library/jest-dom": "^6.9.0",
		"@testing-library/react": "^16.3.0",
		"@types/react": "^19.0.8",
		"@types/react-dom": "^19.0.3",
		"@types/swagger-ui-react": "^5.18.0",
		"@vitejs/plugin-react": "^5.0.0",
		"@vitest/coverage-v8": "^4.0.0",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9.19.0",
		"eslint-plugin-react-hooks": "^7.0.0",
		"eslint-plugin-react-refresh": "^0.4.18",
		"globals": "^16.0.0",
		"harperdb": "4.7.7",
		"husky": "^9.1.7",
		"jsdom": "^27.0.0",
		"semantic-release": "^25.0.0",
		"typescript": "~5.9.0",
		"typescript-eslint": "^8.22.0",
		"vite": "^7.0.0",
		"vitest": "^4.0.0"
	},
	"packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b",
	"license": "Apache-2.0"
}
