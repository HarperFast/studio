# Copy this file to .env.local and adjust values for your machine.
# .env.local is shared by both dev servers:
#   pnpm dev        (alias of dev:fabric) — Fabric mode
#   pnpm dev:local  — Local Studio mode; layers .github/deploy-public-env/.env.dev-local
#                     on top, which sets VITE_LOCAL_STUDIO=true
# That flag is the only difference between the two, so it is not set here.

VITE_PUBLIC_STRIPE_KEY=pk_test_51RBHdeDHkP48ZfZdmWZgigWfBxRrZw9CG9Yg8CzRkx0qWNPbN5p0FeNPPJOLCZeIjGftFTY2CCoPhtQwMOkD88xx00f1kqsf9c
VITE_CENTRAL_MANAGER_API_URL=https://stage.studio.harperfabric.com
VITE_REO_DEV_CLIENT_ID=0
VITE_HOST=localhost

# Local Harper instance the Local Studio UI talks to (used by dev:local)
VITE_LOCAL_STUDIO_DEV_URL=http://localhost:9925
