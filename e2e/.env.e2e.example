# Copy to .env.e2e (gitignored) and fill in. This file holds ONLY the narrow,
# disposable credentials the test harness needs — never the app's .env.local
# (which carries real secrets: OpenAPI admin password, Datadog key, Mailjet keys).

# Target under test. Default if unset: https://dev.studio.harperfabric.com
# Set to http://localhost:5173 to test a locally-served build (auto-starts the dev server).
PLAYWRIGHT_BASE_URL=https://dev.studio.harperfabric.com

# Disposable test account on the target environment. Required for the `setup`
# and `authed` projects (login + org-users). The `anon` specs (sign-in page,
# verifying screen) run WITHOUT these.
# Use a throwaway, low-privilege account — never a real/personal login.
PLAYWRIGHT_USER_EMAIL=
PLAYWRIGHT_USER_PASSWORD=

# Optional: pin which org the authed org-users spec visits. If unset, it's
# derived from the post-login landing URL (works for single-org accounts).
PLAYWRIGHT_ORG_ID=

# --- Email round-trip (Mailosaur) ---
# Controlled test inbox — from the Mailosaur dashboard (Servers → your server).
# The API key is a SECRET: it lives here in .env.e2e only, never committed.
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER_ID=
# Every address <anything>@<MAILOSAUR_SERVER_ID>.mailosaur.net is captured by that
# server. Leave PLAYWRIGHT_TEST_EMAIL blank to auto-generate a unique address per
# run (recommended — avoids cross-run contamination); set it to pin a fixed one.
# MUST stay on a domain we control — never an uncontrolled domain.
PLAYWRIGHT_TEST_EMAIL=
