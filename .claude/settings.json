{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/copy-env-local.sh\"",
						"statusMessage": "Syncing .env.local for this worktree..."
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "pnpm run lint:fix && pnpm run format:fix",
						"statusMessage": "Linting and formatting...",
						"async": true
					}
				]
			}
		]
	}
}
